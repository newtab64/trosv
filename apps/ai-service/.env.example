# FAKE_MODE=true : dung engine heuristic noi bo, khong can API key hay internet
# FAKE_MODE=false: su dung Google Gemini that, yeu cau GEMINI_API_KEY hoac LLM_API_KEY (tra 503 neu thieu key)
FAKE_MODE=false
GEMINI_API_KEY=
# Model mac dinh: gemini-3.5-flash-lite (tu dong fallback gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback tuong thich cho LLM_API_KEY
LLM_API_KEY=
